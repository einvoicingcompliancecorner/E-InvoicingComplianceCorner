# Excludes source/config files from the static-assets upload for the
# site-worker Worker (wrangler.toml: [assets] directory = "../").
# Gitignore-style syntax.
site-worker/
members-worker/
shared/
migrations/
.git/
*.md

# .gitignore was being served. Caught 13 Aug 2026 when a deploy printed
# "+ /.gitignore" as a new asset — it uploaded because it had just been
# edited, but it had been public all along. Not a secret, and every path
# it names 404s anyway, so tidiness rather than an incident; there is
# just no reason to publish one.
#
# `.assetsignore` was NOT being served — wrangler excludes its own config
# file automatically, verified by a 404 before this entry existed. The
# line below is redundant, kept only so nobody has to re-derive that.
#
# REMOVAL IS IMMEDIATE. Adding a file here retires it on the very next
# deploy, even one that reports "No updated asset files to upload": the
# asset MANIFEST is rebuilt in full every time and only the UPLOADS are
# incremental. Verified — /.gitignore returned 404 on the first deploy
# after this change.
.gitignore
.assetsignore

# Test harnesses and their dependencies. [assets] directory is the repo
# ROOT, so anything added at the top level is uploaded and served
# publicly unless it is listed here — node_modules alone is ~1,800 files
# including the workerd binary, which would exceed Cloudflare's 25 MiB
# per-asset limit as well as being nobody's business.
tests/
node_modules/
package.json
package-lock.json

# ----------------------------------------------------------------
# READ THIS BEFORE PANICKING ABOUT THE FILE COUNT (13 Aug 2026).
#
# `wrangler deploy --dry-run` prints e.g. "Read 2,898 files from the
# assets directory". That is a PRE-FILTER walk, not the upload set. The
# actual asset-eligible set at that moment was 72 files.
#
# The proof is `.git/`, three lines above: it has been excluded since
# this file was created, its ~106 files are unquestionably inside that
# 2,898, and the live site has never served `.git`. The count has never
# been the upload count — before node_modules existed here at all, the
# same walk would have reported ~767 against the same 72 eligible files.
#
# If you ever want to confirm it directly rather than by inference, the
# real test is one request after any deploy:
#   curl -sI https://e-invoicingcompliancecorner.com/node_modules/wrangler/package.json
# It should 404.
# ----------------------------------------------------------------

# Asset generators. tools/gen-social-images.mjs builds images/logo.png
# and images/og-default.png; the images themselves ARE served, the script
# that makes them is not.
tools/
